# Copie este arquivo para .env e preencha com os valores do seu bot.
# O .env contém credenciais e NUNCA deve ir para o Git.

# Token do bot (Discord Developer Portal > Bot > Reset Token)
TOKEN=

# Application ID (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=

# Opcional: se preenchido, os comandos são registrados apenas neste servidor,
# o que torna o deploy instantâneo. Se ficar vazio, o registro é global e pode
# levar até 1 hora para propagar.
GUILD_ID=

# Painel web administrativo (opcional; fica desativado sem senha).
# Use uma senha aleatória longa, com pelo menos 16 caracteres.
ADMIN_PASSWORD=

# Por padrão, acessível apenas nesta máquina. Para publicar externamente,
# use HTTPS via proxy reverso, restrinja o acesso pela rede e mantenha Secure.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3000
ADMIN_COOKIE_SECURE=true

# Se o proxy de acesso remoto usar um hostname público diferente do Host local,
# informe a origem exata do navegador (sem caminho), por exemplo:
# ADMIN_PUBLIC_ORIGIN=https://trebot.exemplo.com
ADMIN_PUBLIC_ORIGIN=
